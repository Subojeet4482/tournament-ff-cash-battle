{
  "cleanUrls": false,
  "headers": [
    { "source": "/(.*)\\.(js|html|css|json|webmanifest)", "headers": [ { "key": "Cache-Control", "value": "no-cache, must-revalidate" } ] },
    { "source": "/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" } ] }
  ],
  "rewrites": [
    { "source": "/((?!assets/|components/|css/|js/|pages/|sw\\.js|manifest\\.webmanifest|.*\\..*).*)", "destination": "/index.html" }
  ]
}
